---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
interface Props {
  items: { title: string; href: string; cover: ImageMetadata; alt: string }[];
}
const { items } = Astro.props;
---

<section class="ribbon" aria-label="project previews">
  <div
    class="ribbon-window"
    tabindex="0"
    role="group"
    aria-label="scroll project previews"
  >
    <div class="ribbon-track">
      {[0, 1].map((copy) => (
        <div class="ribbon-group" aria-hidden={copy === 1 ? "true" : undefined}>
          {items.map((item, i) => (
            <a
              class:list={["ribbon-item", `ribbon-item-${i % 4}`]}
              href={item.href}
              aria-label={item.title}
              tabindex={copy === 1 ? -1 : undefined}
            >
              <Image
                src={item.cover}
                alt={copy === 1 ? "" : item.alt}
                widths={[320, 480, 720]}
                sizes="(max-width: 600px) 64vw, 32vw"
                width={720}
                format="webp"
                loading={copy === 0 && i < 3 ? "eager" : "lazy"}
              />
            </a>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>(".ribbon").forEach((ribbon) => {
    const viewport = ribbon.querySelector<HTMLElement>(".ribbon-window")!;
    const track = ribbon.querySelector<HTMLElement>(".ribbon-track")!;
    const group = track.querySelector<HTMLElement>(".ribbon-group")!;

    const nativeAutoplay = matchMedia(
      "(hover: none) and (pointer: coarse) and (prefers-reduced-motion: no-preference)",
    );
    let touching = false;
    let resumeAt = 0;
    let automaticPosition = viewport.scrollLeft;
    let fraction = 0;
    let previousTime = 0;
    let frame = 0;

    function advance(time: number) {
      const elapsed = Math.min(time - previousTime, 50);
      previousTime = time;
      if (!touching && time >= resumeAt && !ribbon.querySelector(":focus-visible")) {
        const width = group.offsetWidth;
        if (width) {
          fraction += elapsed * width / 60_000;
          const pixels = Math.floor(fraction);
          fraction -= pixels;
          viewport.scrollLeft = (viewport.scrollLeft + pixels) % width;
          automaticPosition = viewport.scrollLeft;
        }
      }
      frame = requestAnimationFrame(advance);
    }

    function syncAutoplay() {
      cancelAnimationFrame(frame);
      if (!nativeAutoplay.matches) return;
      automaticPosition = viewport.scrollLeft;
      previousTime = performance.now();
      frame = requestAnimationFrame(advance);
    }

    viewport.addEventListener("touchstart", () => { touching = true; }, { passive: true });
    function releaseTouch(event: TouchEvent) {
      touching = event.touches.length > 0;
      resumeAt = performance.now() + 450;
    }
    viewport.addEventListener("touchend", releaseTouch, { passive: true });
    viewport.addEventListener("touchcancel", releaseTouch, { passive: true });
    nativeAutoplay.addEventListener("change", syncAutoplay);
    syncAutoplay();

    function shift(distance: number) {
      const animation = track.getAnimations()[0];
      const duration = animation?.effect?.getComputedTiming().duration;
      const width = group.getBoundingClientRect().width;
      if (!animation || typeof duration !== "number" || !width) return false;

      const time =
        Number(animation.currentTime ?? 0) + (distance * duration) / width;
      animation.currentTime = ((time % duration) + duration) % duration;
      return true;
    }

    viewport.addEventListener(
      "wheel",
      (event) => {
        const distance =
          event.shiftKey && !event.deltaX ? event.deltaY : event.deltaX;
        if (
          !distance ||
          (!event.shiftKey && Math.abs(distance) <= Math.abs(event.deltaY))
        )
          return;
        const multiplier =
          event.deltaMode === 1
            ? 16
            : event.deltaMode === 2
              ? viewport.clientWidth
              : 1;
        if (event.cancelable && shift(distance * multiplier))
          event.preventDefault();
      },
      { passive: false },
    );

    viewport.addEventListener(
      "scroll",
      () => {
        if (nativeAutoplay.matches) {
          if (viewport.scrollLeft !== automaticPosition) {
            resumeAt = performance.now() + 450;
          }
          return;
        }
        if (viewport.scrollLeft && shift(viewport.scrollLeft))
          viewport.scrollLeft = 0;
      },
      { passive: true },
    );
    ribbon.addEventListener("pointerenter", (event) => {
      if (event.pointerType === "mouse")
        track.getAnimations()[0]?.updatePlaybackRate(0.9);
    });
    ribbon.addEventListener("pointerleave", () =>
      track.getAnimations()[0]?.updatePlaybackRate(1),
    );
  });
</script>
