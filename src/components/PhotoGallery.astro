---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  photos: { src: ImageMetadata; alt: string }[];
}

const { photos } = Astro.props;
const fullImages = await Promise.all(
  photos.map((photo) =>
    getImage({
      src: photo.src,
      width: Math.min(photo.src.width, 1800),
      format: "webp",
    }),
  ),
);
---

<div class="photo-gallery">
  <div class="photo-grid">
    {photos.map((photo, index) => (
      <button
        type="button"
        data-full={fullImages[index].src}
        aria-label={`Enlarge ${photo.alt}`}
      >
        <Image
          src={photo.src}
          alt={photo.alt}
          widths={[200, 400, 700]}
          sizes="31vw"
          width={700}
          format="webp"
          loading="lazy"
        />
      </button>
    ))}
  </div>
  <dialog aria-label="Enlarged photograph">
    <img alt="" />
  </dialog>
</div>

<style>
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(8px, 1.5vw, 24px);
  }
  .photo-grid button {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    min-width: 0;
    overflow: hidden;
    cursor: zoom-in;
  }
  .photo-grid button img {
    width: 100%;
    height: 100%;
    max-height: none;
    object-fit: cover;
  }
  dialog {
    border: 0;
    padding: 0;
    margin: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    background: transparent;
    cursor: zoom-out;
  }
  dialog[open] {
    display: grid;
    place-items: center;
  }
  dialog::backdrop {
    background: rgb(0 0 0 / 70%);
  }
  dialog img {
    width: auto;
    height: auto;
    max-width: 88vw;
    max-height: 85dvh;
    object-fit: contain;
    background: transparent;
    cursor: pointer;
  }
  :global(html:has(.photo-gallery dialog[open])) {
    overflow: hidden;
  }
</style>

<script>
  for (const gallery of document.querySelectorAll(".photo-gallery")) {
    const dialog = gallery.querySelector("dialog")!;
    const enlarged = dialog.querySelector("img")!;

    const buttons = Array.from(
      gallery.querySelectorAll<HTMLButtonElement>("button[data-full]"),
    );
    let current = 0;

    function showPhoto(index: number) {
      current = (index + buttons.length) % buttons.length;
      const button = buttons[current];
      enlarged.alt = button.querySelector("img")!.alt;
      enlarged.src = button.dataset.full!;
    }

    buttons.forEach((button, index) => {
      button.addEventListener("click", () => {
        showPhoto(index);
        dialog.showModal();
      });
    });

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
      if (event.target === enlarged && buttons.length > 1) {
        const bounds = enlarged.getBoundingClientRect();
        showPhoto(
          current + (event.clientX < bounds.left + bounds.width / 2 ? -1 : 1),
        );
      }
    });
    dialog.addEventListener("keydown", (event) => {
      if (
        buttons.length < 2 ||
        (event.key !== "ArrowLeft" && event.key !== "ArrowRight")
      )
        return;
      event.preventDefault();
      showPhoto(current + (event.key === "ArrowLeft" ? -1 : 1));
    });
    dialog.addEventListener("close", () => enlarged.removeAttribute("src"));
  }
</script>
