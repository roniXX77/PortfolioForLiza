---
import { Image } from "astro:assets";
import { archivePath, sitePath } from "../lib/navigation";
import type { CollectionEntry } from "astro:content";
const { projects } = Astro.props as { projects: CollectionEntry<"projects">[] };
function shuffleKey(slug: string) {
  // Stable per-project key keeps the same shuffled order across visits and builds.
  let hash = 2166136261;
  for (const char of slug) {
    hash = Math.imul(hash ^ char.charCodeAt(0), 16777619);
  }
  return hash >>> 0;
}

const work = projects
  .filter((project) => project.data.category !== "digital archive")
  .map((project, index) => ({ project, index, key: shuffleKey(project.data.slug) }))
  .sort((a, b) => a.key - b.key || a.index - b.index);
---

<div class="project-controls">
  <div class="filters" role="group" aria-label="filter projects">
    {["all", "video", "photography", "participation", "canvases"].map(
      (category) => (
        <button
          type="button"
          data-filter={category}
          aria-pressed={category === "all"}
        >
          /{category}
        </button>
      ),
    )}
    <a class="archive-link" href={archivePath}>
      /digital archive
    </a>
  </div>
</div>
<div class="photography-intro project-description" hidden>
  <p>
    Photography is how I study chance and rhythm in the city before forming a
    hypothesis. I follow what catches my eye, but the limits of film and the
    still frame require a precise choice about where to look and when to stop. A
    photographed fragment of the street separates from the landscape I am moving
    through. It begins to exist on its own terms, outside the context that first
    made it familiar to me.
  </p>
  <p>
    I think of the photographs in this section as a film made of stills, without
    a prescribed sequence. A gesture or a body can remain visible without being
    made to stand for a particular person, place or date. The images are grouped
    into series, but I leave individual frames without captions or dates. Their
    order suggests connections without fixing an account of what happened; each
    can be read alongside the others rather than as evidence that explains them.
  </p>
</div>
<p class="filter-status sr-only" aria-live="polite"></p>
<div class="project-grid">
  {work.map(({ project: p }) => (
    <article
      data-category={p.data.category}
      class:list={[
        "project-tile",
        { "matte-cover": p.data.slug === "space-noses-travel-agency" },
      ]}
    >
      <a href={sitePath(`/projects/${p.data.slug}/`)}>
        <div class="project-image">
          <Image
            src={p.data.cover}
            alt={p.data.coverAlt}
            widths={[400, 700, 1100]}
            sizes="(max-width: 700px) 92vw, 46vw"
            width={1100}
            format="webp"
            loading="lazy"
          />
        </div>
        <div class="project-caption">
          <div>
            <h2>{p.data.title}</h2>
            {p.data.demo && <small class="sample-label">sample project</small>}
          </div>
        </div>
      </a>
    </article>
  ))}
</div>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const photographyIntro =
    document.querySelector<HTMLElement>(".photography-intro");
  const grid = document.querySelector(".project-grid");
  const tiles = grid?.querySelectorAll<HTMLElement>(".project-tile") ?? [];

  function filter(category: string) {
    const valid = Array.from(buttons).some(
      (b) => b.dataset.filter === category,
    );
    if (!valid) category = "all";
    const showAll = category === "all";
    if (photographyIntro) photographyIntro.hidden = category !== "photography";
    grid?.classList.toggle("is-filtered", category !== "all");
    grid?.classList.toggle("hide-captions", category === "canvases");
    grid?.classList.toggle("photography-grid", category === "photography");
    grid?.classList.toggle(
      "compact-grid",
      category === "video" || category === "participation" || category === "canvases",
    );
    buttons.forEach((b) =>
      b.setAttribute("aria-pressed", String(b.dataset.filter === category)),
    );
    let count = 0;
    for (const tile of tiles) {
      tile.hidden = !showAll && tile.dataset.category !== category;
      if (!tile.hidden) count++;
    }
    const status = document.querySelector(".filter-status");
    if (status) status.textContent = `${count} projects shown`;
  }
  buttons.forEach((b) =>
    b.addEventListener("click", () => {
      const category = b.dataset.filter!;
      filter(category);
      const url = new URL(location.href);
      if (category === "all") url.searchParams.delete("category");
      else url.searchParams.set("category", category);
      history.pushState(null, "", url);
    }),
  );
  const syncFilter = () =>
    filter(new URLSearchParams(location.search).get("category") ?? "all");
  window.addEventListener("popstate", syncFilter);
  syncFilter();
</script>

<style>
  .project-grid.compact-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    row-gap: clamp(24px, 3vw, 48px);
  }

  .compact-grid .project-tile .project-image :global(img) {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: clamp(180px, 23vw, 350px);
    aspect-ratio: auto;
    object-fit: contain;
    transform: none;
  }

  @media (max-width: 700px) {
    .compact-grid .project-tile .project-image :global(img) {
      max-height: 52vw;
    }
  }

  .project-grid.photography-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    row-gap: clamp(22px, 3vw, 48px);
  }
  .photography-grid .project-image {
    aspect-ratio: 1;
  }
  .photography-grid .project-tile .project-image :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 700px) {
    .project-grid.photography-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .photography-intro {
    max-width: none;
    margin: 0 var(--gutter) clamp(28px, 4vw, 56px);
  }

  .hide-captions .project-caption {
    display: none;
  }

  .matte-cover .project-image :global(img) {
    filter: saturate(0.76) contrast(0.9) brightness(0.94);
  }
</style>
